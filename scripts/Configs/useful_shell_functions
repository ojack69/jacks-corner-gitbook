alias "grep_ip=grep -Eo '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | sort | uniq"
alias "grep_host=grep -Eo '([_a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}' | sort | uniq" 

# Custom functions
function outjoinl(){
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: outjoinl file1 file2"
        return
    fi
    comm -32 <(cat "$1" | sort) <(cat "$2" | sort) | sed 's|\s||g'
}

